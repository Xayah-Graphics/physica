spectra 37 "FLIP and APIC Dam Break" {
    active camera=1 film=1 sampler=1

    particle-sets {
        particle-set 1 "FLIP Fluid" {
            bounds 0 0 0 0.8 1.2 0.6
            visualization display="spheres" field="speed" mapping="value" color-map="turbo" minimum=0 maximum=3
        }
        particle-set 2 "APIC Fluid" {
            bounds 0.95 0 0 1.75 1.2 0.6
            visualization display="spheres" field="speed" mapping="value" color-map="viridis" minimum=0 maximum=3
        }
    }

    volumes {
        grid 1 "FLIP Grid" visible=#false {
            domain 0 0 0 0.8 1.2 0.6
            rendering density-field="level-set" {
                sigma-a rgb-unbounded 0 0 0
                sigma-s rgb-unbounded 0 0 0
                emission rgb-illuminant 0 0 0
                density-scale 0
            }
            diagnostics field="divergence" mode="slice" mapping="value" color-map="turbo" minimum=-0.01 maximum=0.01 slice=0.5 opacity=0.8 axis=2
        }
        grid 2 "APIC Grid" visible=#false {
            domain 0.95 0 0 1.75 1.2 0.6
            rendering density-field="level-set" {
                sigma-a rgb-unbounded 0 0 0
                sigma-s rgb-unbounded 0 0 0
                emission rgb-illuminant 0 0 0
                density-scale 0
            }
            diagnostics field="divergence" mode="slice" mapping="value" color-map="turbo" minimum=-0.01 maximum=0.01 slice=0.5 opacity=0.8 axis=2
        }
    }

    geometries {
        box 1 "FLIP Floor" {
            bounds -0.03 -0.04 -0.03 0.83 0 0.63
        }
        box 2 "APIC Floor" {
            bounds 0.92 -0.04 -0.03 1.78 0 0.63
        }
    }

    materials {
        diffuse 1 "Container" {
            reflectance rgb-albedo 0.055 0.065 0.08
        }
    }

    lights {
        point 1 "Key" {
            intensity rgb-illuminant 32 35 40
            transform {
                row 1 0 0 1.2
                row 0 1 0 2.2
                row 0 0 1 1.8
                row 0 0 0 1
            }
        }
        infinite 2 "Environment" {
            radiance rgb-illuminant 0.03 0.038 0.052
        }
    }

    cameras {
        perspective 1 "Comparison" {
            transform {
                row 0.84 -0.13 0.52 2.65
                row 0 0.97 0.24 1.4
                row -0.54 -0.20 0.81 3
                row 0 0 0 1
            }
            vertical-fov 39
            near-plane 0.01
            far-plane 12
        }
    }

    films {
        film 1 "Comparison Film" gbuffer=#true {
            resolution 1920 1080
            filter gaussian radius-x=1.5 radius-y=1.5
        }
    }

    samplers {
        sampler 1 "Main Sampler" kind="pmj02bn" samples=128 seed=20260829
    }

    prototypes {
        prototype 1 "FLIP Floor Prototype" {
            primitive geometry=1 material=1
        }
        prototype 2 "APIC Floor Prototype" {
            primitive geometry=2 material=1
        }
    }

    instances {
        instance 1 "FLIP Floor" prototype=1
        instance 2 "APIC Floor" prototype=2
    }

    simulation seed=20260829 {
        clock step-seconds=0.008333333333333333
        system "flip-apic-dam-break" "FLIP / APIC Dam Break" provider="physica.example.fluids.liquid.flip_apic_dam_break" {
            scene-bind "flip-particles" 1
            scene-bind "apic-particles" 2
            scene-bind "flip-grid" 1
            scene-bind "apic-grid" 2
        }
    }
}
