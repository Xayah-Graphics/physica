            custom float[] spectra:rendering:emission:wavelengths = []
            custom float spectra:rendering:emissionScale = 1
            custom string spectra:rendering:emissionScaleField = ""
            custom string spectra:rendering:emissionField = ""
            custom token spectra:rendering:fieldColorSpace = "sRGB"
            custom float spectra:rendering:minimumEmissionTemperature = 100
            custom token spectra:rendering:sigmaA:colorSpace = "sRGB"
            custom token spectra:rendering:sigmaA:encoding = "rgbUnbounded"
            custom float[] spectra:rendering:sigmaA:samples = []
            custom float spectra:rendering:sigmaA:scalar = 0
