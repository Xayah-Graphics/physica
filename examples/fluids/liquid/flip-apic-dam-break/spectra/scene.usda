    def Scope "Cameras"
    {
        def Camera "Comparison" (
            displayName = "Comparison"
        )
        {
            float2 clippingRange = (0.01, 12)
            float focalLength = 20.955
            float focusDistance = 1
            token projection = "perspective"
            custom token spectra:cameraType = "perspective"
            custom float spectra:exposureTime = 1
            custom float spectra:farPlane = 12
            custom float spectra:focalDistance = 1
            custom float spectra:lensRadius = 0
            custom string spectra:name = "Comparison"
            custom uint64 spectra:revision:content = 1
            custom uint64 spectra:revision:topology = 1
            custom float spectra:nearPlane = 0.01
            custom float2 spectra:screenMaximum = (1, 1)
            custom float2 spectra:screenMinimum = (-1, -1)
