            custom float spectra:diagnostics:minimum = -0.01
            custom token spectra:diagnostics:mode = "slice"
            custom float spectra:diagnostics:opacity = 0.8
            custom uint spectra:diagnostics:sampling = 8
            custom float spectra:diagnostics:scale = 0.1
            custom float spectra:diagnostics:slicePosition = 0.5
            custom uint spectra:diagnostics:steps = 32
            custom float spectra:diagnostics:threshold = 0.5
            custom float spectra:diagnostics:width = 1.5
            custom point3f spectra:domainMaximum = (0.8, 1.2, 0.6)
