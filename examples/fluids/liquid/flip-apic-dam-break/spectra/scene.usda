            matrix4d xformOp:transform = ( (0.84, 0, -0.54, 0), (-0.13, 0.97, -0.2, 0), (0.52, 0.24, 0.81, 0), (2.65, 1.4, 3, 1) )
            uniform token[] xformOpOrder = ["xformOp:transform"]
