        }
    }

    def Scope "Particles"
    {

        def Points "FLIP_Fluid" (
            displayName = "FLIP Fluid"
        )
        {
            custom token spectra:diagnostics:colorMap = "turbo"
            custom float spectra:diagnostics:maximum = 1
