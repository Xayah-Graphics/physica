spectra 37 "Flag in Wind" {
    active camera=1 film=1 sampler=1
    geometries {
        triangle-mesh 1 "Dynamic Flag Surface" source="assets/flag.ply"
        box 2 "Studio Floor" {
            bounds -1.35 -2.25 -2.1 3.8 -2.16 2.1
        }
        box 3 "Fixed Edge Rail" {
            bounds -0.16 -2.18 -0.07 0.02 0.18 0.07
        }
        box 4 "Rail Foot" {
            bounds -0.38 -2.26 -0.34 0.24 -2.12 0.34
        }
    }
    materials {
        coated-diffuse 1 "Deep Teal Flag" {
            reflectance rgb-albedo 0.035 0.31 0.38
            eta constant 1.46
            interface {
                roughness 0.34
            }
            coating {
                thickness 0.004
                albedo rgb-albedo 0.16 0.20 0.22
                g 0.05
            }
        }
        conductor 2 "Brushed Aluminum" {
            reflectance-optics {
                reflectance rgb-albedo 0.62 0.68 0.72
            }
            roughness 0.24
        }
        diffuse 3 "Charcoal Platform" {
            reflectance rgb-albedo 0.055 0.065 0.08
        }
    }
    lights {
        point 1 "Warm Key" {
            intensity rgb-illuminant 2.4 2.1 1.8
            transform {
                row 1 0 0 2.4
                row 0 1 0 1.8
                row 0 0 1 4.2
                row 0 0 0 1
            }
        }
        point 2 "Cool Fill" {
            intensity rgb-illuminant 0.45 0.65 0.95
            transform {
                row 1 0 0 -1.2
                row 0 1 0 -0.25
                row 0 0 1 2.6
                row 0 0 0 1
            }
        }
        point 3 "Rear Rim" {
            intensity rgb-illuminant 0.55 0.75 0.95
            transform {
                row 1 0 0 2.2
                row 0 1 0 -0.4
                row 0 0 1 -3.0
                row 0 0 0 1
            }
        }
        infinite 4 "Studio Environment" {
            radiance rgb-illuminant 0.035 0.043 0.060
        }
    }
    cameras {
        perspective 1 "Overview" {
            transform {
                row 0.666794859470 -0.079921034632 0.740943482061 5.2
                row 0 0.994232966710 0.107241819772 -0.45
                row -0.745241313525 -0.071508294144 0.662949431317 3.4
                row 0 0 0 1
            }
            vertical-fov 38
            near-plane 0.01
            far-plane 30
        }
    }
    films {
        film 1 "Main Film" gbuffer=#true {
            resolution 1920 1080
            filter gaussian radius-x=1.5 radius-y=1.5
        }
    }
    samplers {
        sampler 1 "Main Sampler" kind="pmj02bn" samples=256 seed=20260809
    }
    prototypes {
        prototype 1 "Flag Prototype" {
            primitive geometry=1 material=1
        }
        prototype 2 "Floor Prototype" {
            primitive geometry=2 material=3
        }
        prototype 3 "Fixed Edge Prototype" {
            primitive geometry=3 material=2
            primitive geometry=4 material=2
        }
    }
    instances {
        instance 1 "Flag" prototype=1
        instance 2 "Studio Floor" prototype=2
        instance 3 "Fixed Edge" prototype=3
    }
    simulation {
        clock step-seconds=0.004166666666666667
        system "cloth" "Cloth" provider="physica.example.deformables.cloth" {
            scene-bind "surface" 1
        }
    }
}
