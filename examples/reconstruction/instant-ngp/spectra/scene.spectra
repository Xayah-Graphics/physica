spectra 37 "Instant NGP Lego" {
    active camera=1 film=1 sampler=1

    neural-fields {
        hash-grid-radiance-field 1 "Radiance Field" {
            diagnostics occupancy-grid=#true
        }
    }

    cameras {
        perspective 1 "Overview" {
            transform {
                row 1 0 0 0.5
                row 0 1 0 0.5
                row 0 0 1 2
                row 0 0 0 1
            }
            far-plane 10
        }
    }

    films {
        film 1 "Display" {
            resolution 1280 720
        }
    }

    samplers {
        sampler 1 "Sampler"
    }

    simulation seed=1337 {
        clock end-step=30000
        system "instant-ngp" "Instant NGP" provider="physica.example.reconstruction.instant-ngp" {
            scene-bind "field" 1
        }
    }
}
